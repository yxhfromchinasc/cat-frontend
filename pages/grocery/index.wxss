/* 杂货铺选货页 */
.grocery-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f5f5;
}

/* 顶层 */
.top-bar {
  background: #fff;
  padding: 24rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  border-bottom: 1rpx solid #eee;
}

.address-section {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.address-icon {
  margin-right: 16rpx;
}

.location-icon {
  width: 40rpx;
  height: 40rpx;
}

.address-content {
  flex: 1;
  min-width: 0;
}

.address-line {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.contact-name {
  margin-right: 16rpx;
}

.address-detail {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.address-empty .empty-text {
  font-size: 28rpx;
  color: #999;
}

.address-arrow {
  font-size: 36rpx;
  color: #999;
  margin-left: 12rpx;
}

.grocery-section {
  flex: 1;
  padding-left: 24rpx;
  border-left: 1rpx solid #eee;
}

.grocery-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.grocery-addr {
  font-size: 22rpx;
  color: #666;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grocery-tip .tip-text.error {
  color: #ff4757;
  font-size: 24rpx;
}

/* 中层：左侧分类 + 右侧商品 */
.middle-area {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: stretch;
  min-height: 0;
}

.category-scroll {
  width: 180rpx;
  height: 100%;
  flex-shrink: 0;
  background: #f8f8f8;
  border-right: 1rpx solid #eee;
}

.category-list {
  padding: 16rpx 0;
}

.category-item {
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  color: #666;
  text-align: center;
}

.category-item.active {
  background: #fff;
  color: #09ccb5;
  font-weight: 600;
  border-left: 4rpx solid #09ccb5;
}

.product-scroll {
  flex: 1;
  height: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  min-width: 0;
}

.product-list {
  padding: 24rpx;
}

.product-item {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.product-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f8f8f8;
}

.product-body {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

/* 第一行：名称 + 价格 */
.product-row-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.product-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-price {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 600;
  color: #ff6b35;
}

/* 第二行：备注 */
.product-row-desc {
  margin-top: 6rpx;
}

.product-desc {
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 第三行：库存 + 加减器 */
.product-row-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.product-stock {
  font-size: 22rpx;
  color: #bbb;
}

.product-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stepper-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #09ccb5;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.stepper-btn.disabled {
  background: #e8e8e8;
  color: #bbb;
}

.stepper-num {
  font-size: 26rpx;
  color: #333;
  min-width: 36rpx;
  text-align: center;
}

.empty-products,
.empty-addr {
  padding: 80rpx 24rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

/* 底层 */
.bottom-bar {
  display: flex;
  align-items: center;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.cart-btn {
  display: flex;
  align-items: center;
  margin-right: 24rpx;
}

.cart-icon-wrap {
  position: relative;
}

.cart-icon {
  width: 56rpx;
  height: 56rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ff4757;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 6rpx;
}

.cart-label {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.order-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: rgba(9, 204, 181, 0.9);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 40rpx;
}

.order-btn.disabled {
  background: #ddd;
  color: #999;
}

/* 购物车弹窗 */
.cart-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: none;
  align-items: flex-end;
}

.cart-modal.show {
  display: flex;
}

.cart-popup {
  width: 100%;
  max-height: 60vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.cart-popup-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.cart-list {
  max-height: 400rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-item-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.cart-item-price {
  font-size: 28rpx;
  color: #ff6b35;
  margin-right: 24rpx;
}

.cart-item-stepper {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cart-item-stepper .stepper-minus,
.cart-item-stepper .stepper-plus {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  background: #09ccb5;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cart-item-stepper .stepper-minus.disabled,
.cart-item-stepper .stepper-plus.disabled {
  background: #e8e8e8;
  color: #bbb;
}

.cart-item-stepper .stepper-num {
  font-size: 26rpx;
  min-width: 36rpx;
  text-align: center;
}

.cart-popup-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #eee;
}

.cart-total {
  font-size: 28rpx;
  color: #666;
}

.cart-close {
  padding: 16rpx 32rpx;
  background: #09ccb5;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
}
