<!-- pages/chat/index.wxml -->
<view class="page">
  <!-- 进入会话时的加载遮罩：会话详情+消息列表加载完成后关闭 -->
  <view class="init-loading-mask" wx:if="{{initLoading}}">
    <view class="init-loading-content">
      <view class="init-loading-spinner"></view>
      <text class="init-loading-text">加载中...</text>
    </view>
  </view>

  <!-- 悬浮订单信息气泡：类型、预约时间、地址，点击跳转订单详情（用户端不展示手机尾号） -->
  <view class="order-bubble-bar" wx:if="{{conversation && conversation.orderNo}}" bindtap="goToOrderDetail">
    <view class="order-bubble">
      <view class="order-bubble-content">
        <view class="order-bubble-main">
          <text class="order-bubble-type">{{conversation.orderServiceType === 5 ? '大件清运' : (conversation.orderServiceType === 3 ? '回收' : (conversation.orderServiceType === 6 ? '杂货铺' : '快递'))}}</text>
          <text class="order-bubble-time" wx:if="{{conversation.orderAppointmentTime}}">{{conversation.orderAppointmentTime}}</text>
        </view>
        <view class="order-bubble-addr" wx:if="{{conversation.orderAddressBrief}}">{{conversation.orderAddressBrief}}</view>
      </view>
      <text class="order-bubble-arrow">›</text>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view 
    id="message-list"
    class="message-list" 
    scroll-y="{{true}}"
    scroll-top="{{scrollTop}}"
    scroll-into-view="{{scrollIntoView}}"
    enable-scroll-anchoring="{{true}}"
    bindscroll="onScroll">
    
    <!-- 加载更多历史消息按钮 -->
    <view class="load-more-bar" wx:if="{{hasMore}}" bindtap="loadMoreHistory">
      <view class="load-more-text" wx:if="{{!loading}}">点击加载更多历史消息</view>
      <view class="history-loading-bar" wx:else>
        <view class="history-loading-spinner"></view>
        <text class="history-loading-text">加载中...</text>
      </view>
    </view>
    
    <view class="message-item" wx:for="{{messageList}}" wx:key="id" wx:for-item="msg">
      <!-- 消息气泡 -->
      <!-- 对方消息：头像在左，内容在右 -->
      <view class="message-bubble other" wx:if="{{!msg.isMine}}">
        <image 
          class="avatar" 
          src="{{conversation.otherUser.avatarUrl || '/assets/tabbar/profile.png'}}" 
          mode="aspectFill"></image>
        
        <view class="content-wrapper">
          <view class="content">
            <!-- 文本消息 -->
            <view wx:if="{{msg.messageType === 1}}" class="text-message">
              <text>{{msg.content}}</text>
            </view>
            
            <!-- 图片消息 -->
            <view wx:if="{{msg.messageType === 2}}" class="image-message">
              <image 
                src="{{msg.imageUrl}}" 
                mode="widthFix"
                bindtap="previewImage"
                data-url="{{msg.imageUrl}}"></image>
            </view>
            
            <!-- 位置消息 -->
            <view wx:if="{{msg.messageType === 3}}" class="location-message" bindtap="openLocation" 
                  data-latitude="{{msg.locationLatitude}}" 
                  data-longitude="{{msg.locationLongitude}}" 
                  data-address="{{msg.locationAddress}}">
              <view class="location-icon">📍</view>
              <view class="location-info">
                <text class="location-name">{{msg.locationAddress || '位置'}}</text>
                <text class="location-hint">点击查看位置</text>
              </view>
            </view>
          </view>
          <!-- 消息时间 -->
          <view class="message-time-wrapper" wx:if="{{msg.timeFormatted}}">
            <text class="message-time">{{msg.timeFormatted}}</text>
          </view>
        </view>
      </view>
      
      <!-- 我的消息：内容在左，头像在右 -->
      <view class="message-bubble mine" wx:if="{{msg.isMine}}">
        <view class="content-wrapper">
          <view class="content">
            <!-- 文本消息 -->
            <view wx:if="{{msg.messageType === 1}}" class="text-message">
              <text>{{msg.content}}</text>
            </view>
            
            <!-- 图片消息 -->
            <view wx:if="{{msg.messageType === 2}}" class="image-message">
              <image 
                src="{{msg.imageUrl}}" 
                mode="widthFix"
                bindtap="previewImage"
                data-url="{{msg.imageUrl}}"></image>
            </view>
            
            <!-- 位置消息 -->
            <view wx:if="{{msg.messageType === 3}}" class="location-message" bindtap="openLocation" 
                  data-latitude="{{msg.locationLatitude}}" 
                  data-longitude="{{msg.locationLongitude}}" 
                  data-address="{{msg.locationAddress}}">
              <view class="location-icon">📍</view>
              <view class="location-info">
                <text class="location-name">{{msg.locationAddress || '位置'}}</text>
                <text class="location-hint">点击查看位置</text>
              </view>
            </view>
          </view>
          <!-- 消息时间和已读状态 -->
          <view class="message-time-wrapper" wx:if="{{msg.timeFormatted}}">
            <text class="message-time">{{msg.timeFormatted}}</text>
            <text class="read-status" wx:if="{{msg.isMine}}">{{msg.isRead ? '已读' : '未读'}}</text>
          </view>
        </view>
        
        <image 
          class="avatar" 
          src="{{currentUserAvatar || '/assets/tabbar/profile.png'}}" 
          mode="aspectFill"></image>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty" wx:if="{{!loading && messageList.length === 0}}">
      <text>暂无消息</text>
    </view>
  </scroll-view>
  
  <!-- 输入工具栏 -->
  <view class="input-bar" wx:if="{{conversation && conversation.isClosed !== 1}}">
    <!-- 输入栏 -->
    <view class="input-row">
      <textarea 
        class="input" 
        placeholder="输入消息..." 
        value="{{inputValue}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="sendTextMessage"
        auto-height="{{true}}"
        maxlength="{{500}}"
        show-confirm-bar="{{false}}"
        cursor-spacing="{{0}}"></textarea>
      <!-- 有输入内容时显示发送按钮，否则显示展开/收起按钮 -->
      <view 
        class="add-btn {{showMoreTools ? 'collapsed' : ''}}" 
        wx:if="{{!hasInput}}"
        bindtap="toggleMoreTools">
        <image class="add-icon" src="{{showMoreTools ? '/assets/tabbar/减号.svg' : '/assets/tabbar/展开.svg'}}" mode="aspectFit"></image>
      </view>
      <button 
        class="send-btn" 
        wx:if="{{hasInput}}"
        bindtap="sendTextMessage" 
        disabled="{{sending}}">
        <image class="send-icon" src="/assets/tabbar/发送.svg" mode="aspectFit"></image>
      </button>
    </view>
    
    <!-- 扩展工具栏（点击加号后展开） -->
    <view class="more-tools {{showMoreTools ? 'show' : ''}}">
      <view class="tool-item" bindtap="chooseImage">
        <view class="tool-icon-wrapper">
          <image class="tool-icon" src="/assets/tabbar/照片.png" mode="aspectFit"></image>
        </view>
        <text class="tool-label">照片</text>
      </view>
      <view class="tool-item" bindtap="chooseLocation">
        <view class="tool-icon-wrapper">
          <image class="tool-icon" src="/assets/tabbar/定位.png" mode="aspectFit"></image>
        </view>
        <text class="tool-label">位置</text>
      </view>
    </view>
  </view>
  
  <!-- 会话已关闭提示 -->
  <view class="closed-tip" wx:if="{{conversation && conversation.isClosed === 1}}">
    <text>订单已结束，无法发送消息</text>
  </view>
  
  <!-- 新消息提示气泡 -->
  <view 
    class="new-message-tip {{showNewMessageTip ? 'show' : ''}}" 
    wx:if="{{showNewMessageTip && newMessageCount > 0}}"
    bindtap="onNewMessageTipTap">
    <text class="new-message-text">新消息 {{newMessageCount}}</text>
  </view>
  
  <!-- 图片预览确认弹窗 -->
  <view class="image-preview-modal" wx:if="{{showImagePreview}}" bindtap="closeImagePreview">
    <view class="image-preview-popup" catchtap="stopPropagation">
      <view class="image-preview-header">
        <text class="image-preview-title">预览图片</text>
        <text class="image-preview-close" bindtap="closeImagePreview">×</text>
      </view>
      <view class="image-preview-content">
        <image class="image-preview-img" src="{{previewImagePath}}" mode="aspectFit"></image>
      </view>
      <view class="image-preview-footer">
        <button class="image-preview-btn cancel-btn" bindtap="closeImagePreview">取消</button>
        <button class="image-preview-btn confirm-btn" bindtap="confirmSendImage">发送</button>
      </view>
    </view>
  </view>
</view>
